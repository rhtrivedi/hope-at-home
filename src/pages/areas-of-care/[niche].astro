---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ContactCta from "../../components/ContactCta.astro";
import { areas, type Area } from "../../data/areas";
import { card, eyebrow, parallaxImage, photo } from "../../data/site";

export function getStaticPaths() {
  return areas.map((area) => ({
    params: { niche: area.slug },
    props: { area },
  }));
}

interface Props {
  area: Area;
}

const { area } = Astro.props;
const [lead, ...paragraphs] = area.fullDescription;
const others = areas.filter((other) => other.slug !== area.slug);

const details = [
  { label: "Session length", value: "50 minutes" },
  { label: "Offered in", value: "English, Hindi & Gujarati" },
];
---

<Layout title={`${area.title} — Hope at Home Counselling Services`} description={area.summary}>
  <Header />

  <main class="mx-auto max-w-7xl px-5 sm:px-8">
    <!-- Hero -->
    <section class="relative pt-12 sm:pt-20">
      <p
        aria-hidden="true"
        data-parallax="-0.12"
        class="pointer-events-none absolute -top-4 right-0 -z-10 select-none font-display text-[36vw] italic leading-none text-sage-200/60 lg:-right-16 lg:text-[24rem]"
      >
        {area.watermark}
      </p>

      <a href="/areas-of-care" class={`reveal link-draw inline-block ${eyebrow}`}>
        <span aria-hidden="true">&larr;</span> Areas of care
      </a>
      <h1 class="reveal mt-6 font-display text-6xl font-medium leading-[0.95] tracking-tight text-zinc-900 sm:text-8xl xl:text-[7rem]">
        {area.title}
      </h1>
      <p class="reveal mt-6 font-display text-2xl italic text-sage-700 sm:pl-16 sm:text-4xl lg:pl-32">{area.closing}</p>

      <div class="reveal mt-12 aspect-video overflow-hidden rounded-2xl sm:aspect-[21/9] lg:mt-16">
        <img src={photo(area.imageId, 1800, "21:9")} alt={area.alt} data-parallax="0.06" class={parallaxImage} fetchpriority="high" />
      </div>
    </section>

    <!-- Story -->
    <section class="grid lg:grid-cols-12" aria-label={`About ${area.title}`}>
      <dl class="order-2 mt-10 space-y-6 lg:order-1 lg:col-span-4 lg:mt-12 lg:pr-12">
        {details.map((item) => (
          <div class="reveal border-t border-zinc-200 pt-5">
            <dt class="text-xs font-semibold uppercase tracking-[0.2em] text-zinc-500">{item.label}</dt>
            <dd class="mt-2 font-display text-2xl font-medium text-zinc-900">{item.value}</dd>
          </div>
        ))}
        <div class="reveal border-t border-zinc-200 pt-5">
          <a href="/services" class="link-redraw group inline-flex items-center gap-2 text-sm font-semibold text-zinc-900 transition-colors duration-300 hover:text-rose-600">
            Services &amp; fees
            <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </dl>

      <div class="reveal relative z-10 order-1 mx-4 -mt-12 rounded-2xl bg-white p-8 shadow-xl sm:p-12 lg:order-2 lg:col-span-8 lg:mx-0 lg:-mt-28 lg:mr-10 lg:p-16">
        <p class="reveal font-display text-2xl leading-snug text-zinc-900 sm:text-3xl sm:leading-snug">{lead}</p>
        {paragraphs.map((paragraph) => (
          <p class="reveal mt-6 text-lg leading-relaxed">{paragraph}</p>
        ))}
        <a href="/contact" data-magnetic class="mt-10 inline-block rounded-xl bg-rose-600 px-7 py-4 text-center text-base font-semibold text-white transition-all duration-300 hover:scale-[1.02] hover:bg-rose-700 hover:shadow-lg">
          Let's Connect
        </a>
      </div>
    </section>

    <!-- Benefits -->
    <section class="grid gap-12 py-24 sm:py-32 lg:grid-cols-12" aria-labelledby="benefits-heading">
      <div class="reveal lg:col-span-4">
        <div class="lg:sticky lg:top-32">
          <p class={eyebrow}>How we can help</p>
          <h2 id="benefits-heading" class="mt-4 font-display text-4xl font-medium tracking-tight text-zinc-900 sm:text-5xl">
            What our time together can offer.
          </h2>
        </div>
      </div>

      <ol class="lg:col-span-7 lg:col-start-6">
        {area.benefits.map((benefit, i) => (
          <li class="reveal flex items-baseline gap-6 border-t border-zinc-200 py-8 last:border-b sm:gap-10">
            <span class="font-display text-lg italic text-sage-600" aria-hidden="true">0{i + 1}</span>
            <span class="font-display text-2xl font-medium leading-snug text-zinc-900 sm:text-3xl sm:leading-snug">{benefit}</span>
          </li>
        ))}
      </ol>
    </section>

    <!-- Other areas -->
    <section class="pb-24 sm:pb-32" aria-labelledby="others-heading">
      <div class="reveal flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <h2 id="others-heading" class="font-display text-4xl font-medium tracking-tight text-zinc-900 sm:text-5xl">Other areas of care</h2>
        <a href="/areas-of-care" class="link-redraw self-start text-sm font-semibold text-zinc-900 transition-colors duration-300 hover:text-rose-600 md:self-auto">
          Explore all areas
        </a>
      </div>

      <div class="mt-12 grid gap-4 sm:gap-5 md:grid-cols-3">
        {others.map((other, i) => (
          <a href={other.href} class:list={[card, "group flex flex-col overflow-hidden border border-zinc-200 bg-white", i === 1 && "md:translate-y-10"]}>
            <div class="aspect-video overflow-hidden">
              <img src={photo(other.imageId, 800)} alt={other.alt} loading="lazy" class="size-full object-cover transition-transform duration-700 group-hover:scale-105" />
            </div>
            <div class="flex flex-1 flex-col p-8">
              <h3 class="font-display text-2xl font-medium text-zinc-900">{other.title}</h3>
              <p class="mt-3 font-display italic text-sage-700">{other.closing}</p>
              <span class="mt-auto inline-flex items-center gap-2 pt-8 text-sm font-semibold text-zinc-900">
                Learn more
                <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">&rarr;</span>
              </span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <ContactCta />
  </main>

  <Footer />
</Layout>
