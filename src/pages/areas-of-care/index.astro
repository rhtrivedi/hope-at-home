---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import AreaIcon from "../../components/AreaIcon.astro";
import ContactCta from "../../components/ContactCta.astro";
import { areas } from "../../data/areas";
import { cardLink, container, h3 } from "../../data/site";
---

<Layout
  title="Areas of Care — Hope at Home Counselling Services"
  description={`Counselling for ${areas.map((area) => area.title).join(", ")} — a compassionate, judgment-free space with Kunjal Bhatt, RSW.`}
>
  <PageHero
    eyebrow="Our areas of care"
    title="What would you like support with?"
    lead="Everyone's story is different — and so is the support they need. Choose the one that sounds most like you."
  />

  <section class={`${container} py-6 sm:py-10`} aria-label="Areas of care">
    <ul class="grid gap-4 sm:grid-cols-2">
      {areas.map((area) => (
        <li class="flex">
          <a href={area.href} class={`${cardLink} w-full`}>
            <span class="grid size-20 place-items-center rounded-2xl bg-tint text-ink"><AreaIcon slug={area.slug} class="size-14" /></span>
            <h2 class={`${h3} mt-4`}>{area.title}</h2>
            <p class="mt-3 text-lg leading-relaxed text-body">{area.short}</p>
            <p class="mt-4 text-lg font-bold text-brand">{area.closing}</p>
            <span class="mt-auto pt-6 text-base font-bold text-ink underline decoration-2 underline-offset-4 group-hover:decoration-accent-strong">
              Read about {area.title} <span aria-hidden="true">&rarr;</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <ContactCta />
</Layout>
