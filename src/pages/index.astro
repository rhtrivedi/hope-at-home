---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ContactCta from "../components/ContactCta.astro";
import { areas } from "../data/areas";
import { card, eyebrow, parallaxImage, phone, photo, services } from "../data/site";

// How each area is presented in the homepage bento, in the same order as the data.
const tileStyles = [
  { layout: "md:col-span-2 lg:col-span-8", tone: "bg-zinc-900", dark: true, wide: true },
  { layout: "lg:col-span-4", tone: "bg-sage-100", dark: false, wide: false },
  { layout: "lg:col-span-4", tone: "bg-rose-50", dark: false, wide: false },
  { layout: "md:col-span-2 lg:col-span-8", tone: "border border-zinc-200 bg-white", dark: false, wide: true },
];

const tiles = areas.map((area, i) => ({
  ...area,
  ...tileStyles[i % tileStyles.length],
  image: photo(area.imageId, 1400, "21:9"),
}));

const stats = [
  { value: "12+", label: "Years in social work" },
  { value: "RSW", label: "BSW, MSW — Registered Social Worker" },
  { value: "3", label: "Languages: English, Hindi, Gujarati" },
];

const watermark = "pointer-events-none absolute -z-10 select-none font-display italic leading-none";
---

<Layout
  title="Hope at Home Counselling Services — A Place for Hope. A Space for Change."
  description="Compassionate, judgment-free counselling with Kunjal Bhatt, RSW. Support for postpartum, anxiety and depression, ADHD, couples, children and youth — in English, Hindi and Gujarati."
>
  <Header />

  <main class="mx-auto max-w-7xl px-5 sm:px-8">
    <!-- Hero -->
    <section class="relative pb-24 pt-12 sm:pt-20 lg:pb-48">
      <p aria-hidden="true" data-parallax="-0.12" class={`${watermark} -top-4 right-0 text-[38vw] text-sage-200/60 lg:-right-16 lg:text-[26rem]`}>
        hope
      </p>

      <p class={`reveal ${eyebrow}`}>Counselling in English, Hindi &amp; Gujarati</p>
      <h1 class="reveal mt-6 font-display text-6xl font-medium leading-[0.95] tracking-tight text-zinc-900 sm:text-8xl xl:text-[7rem]">
        A place for hope.
        <span class="block italic text-sage-700 sm:pl-16 lg:pl-32">A space for change.</span>
      </h1>

      <div class="relative mt-12 lg:ml-[24%] lg:mt-16">
        <div class="reveal aspect-video overflow-hidden rounded-2xl sm:aspect-[21/9]">
          <img
            src={photo("1586023492125-27b2c045efd7", 1600, "21:9")}
            alt="A calm, sunlit room with an armchair and a framed print"
            data-parallax="0.06"
            class={parallaxImage}
            fetchpriority="high"
          />
        </div>

        <div class="reveal relative z-10 mx-4 -mt-12 rounded-2xl bg-white p-8 shadow-xl sm:p-10 lg:absolute lg:-bottom-28 lg:-left-[28%] lg:mx-0 lg:mt-0 lg:w-[27rem]">
          <p class="text-lg leading-relaxed text-zinc-700">
            At Hope at Home, we believe that meaningful change can begin with a conversation. You deserve support that respects your
            experiences, your values, and your goals.
          </p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a href="/contact" data-magnetic class="rounded-xl bg-rose-600 px-7 py-4 text-center text-base font-semibold text-white transition-all duration-300 hover:scale-[1.02] hover:bg-rose-700 hover:shadow-lg">
              Let's Connect
            </a>
            <a href={phone.href} data-magnetic class="rounded-xl border border-zinc-300 px-7 py-4 text-center text-base font-semibold text-zinc-900 transition-all duration-300 hover:scale-[1.02] hover:border-zinc-900 hover:shadow-lg">
              {phone.label}
            </a>
          </div>
        </div>

        <div class="reveal absolute -top-8 right-6 hidden rounded-2xl bg-zinc-900 p-6 text-white shadow-xl sm:block lg:-top-12 lg:right-10 lg:-rotate-3">
          <p class="font-display text-4xl font-medium">12+</p>
          <p class="mt-1 max-w-36 text-sm leading-snug text-zinc-300">years supporting children, families and individuals</p>
        </div>

        <p class="reveal mt-8 font-display text-xl italic text-sage-700 lg:text-right lg:text-2xl">
          No judgment. No pressure. Just a safe place to start.
        </p>
      </div>
    </section>

    <!-- Areas of care -->
    <section class="pb-24 sm:pb-32" aria-labelledby="areas-heading">
      <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <div class="reveal">
          <p class={eyebrow}>Our areas of care</p>
          <h2 id="areas-heading" class="mt-4 max-w-2xl font-display text-4xl font-medium tracking-tight text-zinc-900 sm:text-5xl">
            Support shaped around what you're carrying.
          </h2>
        </div>
        <a href="/areas-of-care" class="link-redraw self-start text-sm font-semibold text-zinc-900 transition-colors duration-300 hover:text-rose-600 md:self-auto">
          Explore all areas
        </a>
      </div>

      <div class="mt-12 grid gap-4 sm:gap-5 md:grid-cols-2 lg:grid-cols-12">
        {tiles.map((area) => (
          <a href={area.href} class:list={[card, area.layout, area.tone, "group flex flex-col overflow-hidden"]}>
            {area.wide && (
              <div class="aspect-video overflow-hidden sm:aspect-[21/9]">
                <img src={area.image} alt={area.alt} loading="lazy" class="size-full object-cover transition-transform duration-700 group-hover:scale-105" />
              </div>
            )}
            <div class="flex flex-1 flex-col p-8 sm:p-10">
              <h3 class:list={["font-display text-2xl font-medium sm:text-3xl", area.dark ? "text-white" : "text-zinc-900"]}>{area.title}</h3>
              <p class:list={["mt-4 max-w-2xl leading-relaxed", area.dark ? "text-zinc-300" : "text-zinc-600"]}>{area.summary}</p>
              <p class:list={["mt-6 font-display text-lg italic", area.dark ? "text-rose-300" : "text-sage-700"]}>{area.closing}</p>
              <span class:list={["mt-auto inline-flex items-center gap-2 pt-8 text-sm font-semibold", area.dark ? "text-white" : "text-zinc-900"]}>
                Learn more
                <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">&rarr;</span>
              </span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- About -->
    <section class="relative py-12 lg:py-24" aria-labelledby="about-heading">
      <p aria-hidden="true" data-parallax="-0.1" class={`${watermark} -top-10 right-0 text-[30vw] text-sage-200/50 lg:text-[20rem]`}>
        Kunjal
      </p>

      <div class="grid lg:grid-cols-12 lg:grid-rows-[auto_1fr]">
        <div class="reveal aspect-video overflow-hidden rounded-2xl lg:col-start-1 lg:col-end-9 lg:row-start-1">
          <!-- Placeholder: replace with Kunjal's portrait -->
          <img src={photo("1518531933037-91b2f5f229cc", 1400)} alt="Deep green leaves" loading="lazy" data-parallax="0.06" class={parallaxImage} />
        </div>

        <div class="reveal relative z-10 mx-4 -mt-12 rounded-2xl bg-white p-8 shadow-xl sm:p-12 lg:col-start-6 lg:col-end-13 lg:row-start-1 lg:row-end-3 lg:mx-0 lg:mt-36 lg:p-16">
          <p class={eyebrow}>The heart behind Hope at Home</p>
          <h2 id="about-heading" class="mt-4 font-display text-4xl font-medium tracking-tight text-zinc-900 sm:text-6xl">Hi, I'm Kunjal.</h2>
          <div class="mt-8 space-y-5 text-lg leading-relaxed">
            <p>
              Over the years, I've supported children, families, Indigenous communities, individuals with disabilities, and people navigating
              mental health and life challenges. These experiences have taught me that everyone's story is different — and so is the support
              they need.
            </p>
            <p>
              Outside of work, I'm a wife and mom to two growing minds, so I understand that life can be busy, messy, and sometimes
              overwhelming.
            </p>
          </div>
          <a href="/about" class="link-redraw group mt-10 inline-flex items-center gap-2 text-sm font-semibold text-zinc-900 transition-colors duration-300 hover:text-rose-600">
            Read my story
            <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">&rarr;</span>
          </a>
        </div>

        <dl class="mt-10 grid gap-8 sm:grid-cols-3 lg:col-start-1 lg:col-end-6 lg:row-start-2 lg:mt-12 lg:grid-cols-1 lg:gap-6 lg:pr-12">
          {stats.map((stat) => (
            <div class="reveal flex items-baseline gap-5 border-t border-zinc-200 pt-5">
              <dt class="w-20 shrink-0 font-display text-4xl font-medium text-zinc-900">{stat.value}</dt>
              <dd class="text-sm leading-snug text-zinc-600">{stat.label}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- Services & coverage -->
    <section class="py-24 sm:py-32" aria-labelledby="services-heading">
      <div class="reveal">
        <p class={eyebrow}>Services &amp; fees</p>
        <h2 id="services-heading" class="mt-4 font-display text-4xl font-medium tracking-tight text-zinc-900 sm:text-5xl">Care for every chapter.</h2>
      </div>

      <div class="mt-12 grid gap-4 sm:gap-5 md:grid-cols-3 lg:grid-cols-12">
        {services.map((service) => (
          <a href="/services" class={`${card} group flex flex-col border border-zinc-200 bg-white p-8 lg:col-span-3`}>
            <h3 class="font-display text-2xl font-medium leading-snug text-zinc-900">{service.title}</h3>
            <p class="mt-3 text-sm italic text-sage-700">{service.tagline}</p>
            <p class="mt-auto pt-12">
              <span class="font-display text-5xl font-medium text-zinc-900">${service.price}</span>
              <span class="ml-1 text-sm text-zinc-500">/ 50 min</span>
            </p>
            <p class="mt-3 text-xs font-semibold uppercase tracking-[0.2em] text-rose-600">Your time. Your space.</p>
          </a>
        ))}

        <div class="reveal rounded-2xl bg-sage-200 p-8 md:col-span-3 lg:col-span-3">
          <h3 class="font-display text-2xl font-medium text-zinc-900">Insurance &amp; coverage</h3>
          <ul class="mt-5 space-y-4 text-sm leading-relaxed text-sage-900">
            <li>Eligible for coverage through many major insurance providers.</li>
            <li>Registered with the Non-Insured Health Benefits (NIHB) program for eligible First Nations people and recognized Inuit.</li>
            <li>Provider not listed? Reach out — we'll do our best to help with registration.</li>
          </ul>
          <a href="/services#insurance" class="group mt-6 inline-flex items-center gap-2 text-sm font-semibold text-zinc-900">
            See coverage details
            <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
      <p class="mt-6 text-sm text-zinc-500">Coverage varies by plan. We recommend checking with your insurance provider to confirm your individual benefits.</p>
    </section>

    <ContactCta />
  </main>

  <Footer />
</Layout>
