---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/PageHero.astro";
import ContactCta from "../components/ContactCta.astro";
import { areas } from "../data/areas";
import { card, eyebrow, services } from "../data/site";

const coverage = [
  {
    title: "Major insurance providers",
    body: "Our services are eligible for coverage through many major insurance providers, making it easier to use your benefits.",
    // TODO: link to the list of insurers once the client supplies it.
    link: { label: "Ask about your provider", href: "/contact" },
  },
  {
    title: "Provider not listed?",
    body: "If your insurance provider is not currently listed with us, please reach out — we'll do our best to support you with the registration process where possible.",
    link: { label: "Reach out", href: "/contact" },
  },
  {
    title: "Non-Insured Health Benefits (NIHB)",
    body: "We are also registered with the NIHB program, which provides coverage for eligible registered First Nations people and recognized Inuit.",
  },
];
---

<Layout
  title="Services & Fees — Hope at Home Counselling Services"
  description="Child and youth, individual and couples counselling in 50-minute sessions from $120. Eligible for coverage through many major insurance providers and the NIHB program."
>
  <Header />

  <main class="mx-auto max-w-7xl px-5 sm:px-8">
    <PageHero
      eyebrow="Services & fees"
      title="Care for every chapter."
      lead="Your time. Your space. Every session is 50 minutes."
      watermark="care"
    />

    <!-- Services -->
    <section class="grid gap-4 sm:gap-5 md:grid-cols-3" aria-label="Counselling services">
      {services.map((service, i) => (
        <article class:list={[card, "group flex flex-col overflow-hidden border border-zinc-200 bg-white", i === 1 && "md:translate-y-10"]}>
          <div class="aspect-video overflow-hidden">
            <img src={service.image} alt={service.alt} class="size-full object-cover transition-transform duration-700 group-hover:scale-105" />
          </div>
          <div class="flex flex-1 flex-col p-8 sm:p-10">
            <h2 class="font-display text-3xl font-medium leading-snug text-zinc-900">{service.title}</h2>
            <p class="mt-3 font-display text-lg italic text-sage-700">{service.tagline}</p>
            <p class="mt-5 leading-relaxed">{service.blurb}</p>
            <p class="mt-auto pt-12">
              <span class="font-display text-6xl font-medium text-zinc-900">${service.price}</span>
              <span class="ml-1 text-sm text-zinc-500">/ 50 min</span>
            </p>
            <a href="/contact" data-magnetic class="mt-8 rounded-xl bg-zinc-900 px-6 py-3.5 text-center text-sm font-semibold text-white transition-all duration-300 hover:bg-rose-600">
              Let's Connect
            </a>
          </div>
        </article>
      ))}
    </section>

    <!-- Areas of care -->
    <section class="py-24 sm:py-32 md:pt-40" aria-labelledby="areas-heading">
      <div class="reveal">
        <p class={eyebrow}>Our areas of care</p>
        <h2 id="areas-heading" class="mt-4 max-w-2xl font-display text-4xl font-medium tracking-tight text-zinc-900 sm:text-5xl">
          What we can work through together.
        </h2>
      </div>
      <div class="mt-12 grid gap-4 sm:grid-cols-2 sm:gap-5 lg:grid-cols-4">
        {areas.map((area, i) => (
          <a href={area.href} class:list={[card, "group flex min-h-56 flex-col p-8", i % 2 === 0 ? "bg-sage-100" : "bg-rose-50"]}>
            <h3 class="font-display text-2xl font-medium text-zinc-900">{area.title}</h3>
            <p class="mt-3 font-display italic text-sage-700">{area.closing}</p>
            <span class="mt-auto inline-flex items-center gap-2 pt-8 text-sm font-semibold text-zinc-900">
              Learn more
              <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">&rarr;</span>
            </span>
          </a>
        ))}
      </div>
    </section>

    <!-- Insurance & coverage -->
    <section id="insurance" class="mb-24 grid scroll-mt-28 gap-4 sm:mb-32 sm:gap-5 lg:grid-cols-12" aria-labelledby="insurance-heading">
      <div class="reveal flex flex-col justify-between rounded-2xl bg-sage-200 p-8 sm:p-12 lg:col-span-5 lg:p-16">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-sage-800">Insurance &amp; coverage</p>
        <div class="mt-16">
          <h2 id="insurance-heading" class="font-display text-4xl font-medium leading-tight tracking-tight text-zinc-900 sm:text-5xl">
            We make accessing counselling as simple as possible.
          </h2>
          <p class="mt-8 text-sm leading-relaxed text-sage-900">
            Coverage varies by plan. We recommend checking with your insurance provider to confirm your individual benefits.
          </p>
        </div>
      </div>

      <div class="grid gap-4 sm:gap-5 lg:col-span-7">
        {coverage.map((item) => (
          <div class={`${card} border border-zinc-200 bg-white p-8 sm:p-10`}>
            <h3 class="font-display text-2xl font-medium text-zinc-900">{item.title}</h3>
            <p class="mt-3 leading-relaxed">{item.body}</p>
            {item.link && (
              <a href={item.link.href} class="link-redraw group mt-5 inline-flex items-center gap-2 text-sm font-semibold text-zinc-900 transition-colors duration-300 hover:text-rose-600">
                {item.link.label}
                <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">&rarr;</span>
              </a>
            )}
          </div>
        ))}
      </div>
    </section>

    <ContactCta />
  </main>

  <Footer />
</Layout>
