---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import ContactCta from "../components/ContactCta.astro";
import Faq from "../components/Faq.astro";
import { areas } from "../data/areas";
import { card, container, eyebrow, h2, h3, services, textLink } from "../data/site";

const coverage = [
  {
    title: "Major insurance providers",
    body: "Our services are eligible for coverage through many major insurance providers, making it easier to use your benefits.",
    link: { label: "See the list of insurers", href: "/services/insurance" },
  },
  {
    title: "Provider not listed?",
    body: "Please reach out. We'll do our best to support you with the registration process where possible.",
    link: { label: "Reach out", href: "/contact" },
  },
];

// Programs that pay for counselling directly. Wording and links are from the client's email (October 2026).
const programs = [
  {
    title: "Non-Insured Health Benefits (NIHB)",
    who: "For eligible registered First Nations people and recognized Inuit",
    body: "We are registered with the NIHB program, which provides coverage for eligible registered First Nations people and recognized Inuit.",
    link: { label: "Read about the NIHB program", href: "https://www.sac-isc.gc.ca/eng/1572537161086/1572537234517" },
  },
  {
    title: "Victim Quick Response Program+ (VQRP+)",
    who: "For victims of violent crime in Ontario",
    body: "We are an approved VQRP+ service provider. We proudly support victims of violent crime in Ontario with funded short-term counselling and emergency support services, billed directly to the program.",
    link: { label: "Read about the VQRP+ program", href: "https://www.cleo.on.ca/en/publications/the-victim-quick-response-program" },
  },
];
---

<Layout
  title="Services & Fees — Hope at Home Counselling Services"
  description="Child and youth, individual and couples counselling in 50-minute sessions from $120. Eligible for coverage through many major insurance providers and the NIHB program."
>
  <PageHero eyebrow="Services and fees" title="Care for every chapter." lead="Your time. Your space. Every session is 50 minutes." />

  <!-- Services -->
  <section class={`${container} py-6 sm:py-10`} aria-label="Counselling services">
    <ul class="grid gap-4 md:grid-cols-3">
      {services.map((service) => (
        <li class="sticky-note flex flex-col p-6 pb-12 sm:p-8 sm:pb-14">
          <h2 class="font-display text-2xl font-semibold leading-snug">{service.title}</h2>
          <p class="mt-2 text-lg font-bold">{service.tagline}</p>
          <p class="mt-4 text-lg leading-relaxed">{service.blurb}</p>
          <p class="mt-auto pt-6 font-display text-5xl font-semibold">
            ${service.price} <span class="mt-1 block font-sans text-base font-normal">for 50 minutes</span>
          </p>
        </li>
      ))}
    </ul>
  </section>

  <!-- Insurance & coverage -->
  <section id="insurance" class={`${container} py-10 sm:py-14`} aria-labelledby="insurance-heading">
    <p class={eyebrow}>Insurance and coverage</p>
    <h2 id="insurance-heading" class={`${h2} mt-2 max-w-3xl`}>We make accessing counselling as simple as possible.</h2>

    <ul class="mt-8 grid gap-4 md:grid-cols-2">
      {coverage.map((item) => (
        <li class={card}>
          <h3 class={h3}>{item.title}</h3>
          <p class="mt-3 max-w-[65ch] text-lg leading-relaxed text-body">{item.body}</p>
          {item.link && (
            <a href={item.link.href} class={`${textLink} mt-4 inline-flex min-h-11 items-center gap-2`}>
              {item.link.label} <span aria-hidden="true">&rarr;</span>
            </a>
          )}
        </li>
      ))}
    </ul>

    <p class="mt-6 max-w-[65ch] rounded-2xl bg-tint p-6 text-lg leading-relaxed text-body">
      <strong class="text-ink">Please check first.</strong> Coverage varies by plan. We recommend checking with your insurance provider to
      confirm your individual benefits.
    </p>
  </section>

  <!-- Funded programs -->
  <section id="programs" class={`${container} scroll-mt-8 py-10 sm:py-14`} aria-labelledby="programs-heading">
    <p class={eyebrow}>Funded programs</p>
    <h2 id="programs-heading" class={`${h2} mt-2 max-w-3xl`}>Two programs that can cover the cost for you.</h2>

    <ul class="mt-8 grid gap-4 md:grid-cols-2">
      {programs.map((program) => (
        <li class={`${card} flex flex-col`}>
          <h3 class={h3}>{program.title}</h3>
          <p class="mt-2 text-lg font-bold text-brand">{program.who}</p>
          <p class="mt-3 max-w-[65ch] text-lg leading-relaxed text-body">{program.body}</p>
          <a href={program.link.href} target="_blank" rel="noopener noreferrer" class={`${textLink} mt-auto inline-flex min-h-11 items-center gap-2 pt-4`}>
            {program.link.label} (opens in a new tab)
          </a>
        </li>
      ))}
    </ul>
  </section>

  <Faq />

  <!-- Areas of care -->
  <nav class={`${container} py-6`} aria-labelledby="areas-heading">
    <h2 id="areas-heading" class={h2}>What we can work through together</h2>
    <ul class="mt-4">
      {areas.map((area) => (
        <li>
          <a href={area.href} class={`${textLink} inline-flex min-h-12 items-center gap-2`}>
            {area.title} <span aria-hidden="true">&rarr;</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <ContactCta />
</Layout>
