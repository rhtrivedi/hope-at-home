---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import { areas } from "../data/areas";
import { buttonPrimary, card, cardLink, container, email, figure, formAjaxEndpoint, formEndpoint, h2, h3, hours, phone, psychologyTodayUrl, services, textLink } from "../data/site";

const topics = [...areas.map((area) => area.title), ...services.map((service) => service.title), "Insurance & coverage", "Something else"].filter(
  (topic, i, all) => all.indexOf(topic) === i,
);

const contactMethods = ["Email", "Phone call", "Text message"];

const label = "block text-lg font-bold text-ink";
const hint = "mt-1 text-base text-body";
const optional = "font-normal text-body";
// Labels sit above every field and stay visible; placeholders are never used as labels.
const field =
  "mt-2 block min-h-14 w-full rounded-xl border-2 border-field bg-surface px-4 py-3 text-lg text-ink transition-colors duration-300 hover:border-ink";
---

<Layout
  title="Contact Us — Hope at Home Counselling Services"
  description="Reach out to Hope at Home Counselling Services. Call 519-701-5740, email, or send a message. Open Monday to Friday 9am–9pm and Saturday 9am–5pm."
>
  <PageHero
    eyebrow="Contact us"
    title="When you are ready, we are here."
    lead="There are three ways to reach us. Choose whichever feels easiest."
  />

  <!-- Three ways to reach us -->
  <section class={`${container} py-6 sm:py-10`} aria-label="Ways to reach us">
    <ul class="grid gap-4 md:grid-cols-3">
      <li class="flex">
        <a href={phone.href} class={`${cardLink} w-full`}>
          <h2 class={h3}>Call</h2>
          <p class={`${figure} mt-3 text-3xl`}>{phone.label}</p>
          <span class="mt-auto pt-4 text-base text-body">Opens your phone app</span>
        </a>
      </li>
      <li class="flex">
        <a href={`mailto:${email}`} class={`${cardLink} w-full`}>
          <h2 class={h3}>Email</h2>
          <p class="mt-3 text-lg font-bold text-ink [overflow-wrap:anywhere]">{email}</p>
          <span class="mt-auto pt-4 text-base text-body">Opens your email app</span>
        </a>
      </li>
      <li class="flex">
        <a href="#form-heading" class={`${cardLink} w-full`}>
          <h2 class={h3}>Send a message</h2>
          <p class="mt-3 text-lg text-body">Fill in the short form on this page.</p>
          <span class="mt-auto pt-4 text-base text-body">Go to the form <span aria-hidden="true">&darr;</span></span>
        </a>
      </li>
    </ul>
  </section>

  <!-- Hours -->
  <section class={`${container} py-6`} aria-labelledby="hours-heading">
    <div class="rounded-2xl bg-tint p-6 sm:p-8">
      <h2 id="hours-heading" class={h3}>Schedule and availability</h2>
      <dl class="mt-4 grid gap-4 sm:grid-cols-2">
        {hours.map((slot) => (
          <div>
            <dt class="text-lg font-bold text-ink">{slot.days}</dt>
            <dd class="text-lg text-body">{slot.time}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Form -->
  <section class={`${container} py-10 sm:py-14`} aria-labelledby="form-heading">
    <div class={`${card} max-w-3xl`}>
      <h2 id="form-heading" tabindex="-1" class={`${h2} scroll-mt-8 focus:outline-none`}>Send a message</h2>

      <!-- Shown in place of the form once a message has been sent (see the script at the end of this file). -->
      <div id="form-done" tabindex="-1" hidden class="mt-6 rounded-2xl bg-tint p-6 focus:outline-none sm:p-8">
        <p class="font-display text-2xl font-semibold text-ink">Thank you. Your message has been sent.</p>
        <p class="mt-3 max-w-[65ch] text-lg leading-relaxed text-body">
          <strong class="text-ink">What happens next:</strong> we will get back to you the way you chose. There is nothing else you need to do.
        </p>
      </div>

      <!-- Without JavaScript the form still posts normally and FormSubmit shows its own confirmation page. -->
      <form id="contact-form" action={formEndpoint} data-ajax={formAjaxEndpoint} method="post" class="mt-4 space-y-8">
        <p class="max-w-[65ch] text-lg leading-relaxed">Only your name and email are needed. Everything else is optional.</p>
        <input type="hidden" name="_subject" value="New message from the Hope at Home website" />
        <input type="hidden" name="_template" value="table" />
        <!-- No picture puzzle: it is a barrier for many visitors. The hidden field below catches most spam instead. -->
        <input type="hidden" name="_captcha" value="false" />
        <input type="text" name="_honey" tabindex="-1" autocomplete="off" aria-hidden="true" class="hidden" />
        <div>
          <label for="name" class={label}>Your name</label>
          <input id="name" name="name" type="text" autocomplete="name" required class={field} />
        </div>

        <div>
          <label for="email" class={label}>Your email</label>
          <p id="email-hint" class={hint}>For example: name@example.com</p>
          <input id="email" name="email" type="email" autocomplete="email" required aria-describedby="email-hint" class={field} />
        </div>

        <div>
          <label for="phone" class={label}>Your phone number <span class={optional}>(optional)</span></label>
          <input id="phone" name="phone" type="tel" autocomplete="tel" class={field} />
        </div>

        <fieldset>
          <legend class={label}>How should we get back to you?</legend>
          <div class="mt-3 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            {contactMethods.map((method, i) => (
              <label class="flex min-h-14 cursor-pointer items-center gap-3 rounded-xl border-2 border-field bg-surface px-5 text-lg font-bold text-ink transition-colors duration-300 hover:border-ink has-checked:border-ink has-checked:bg-tint-strong">
                <input type="radio" name="reply-by" value={method} checked={i === 0} class="size-5 accent-ink" />
                {method}
              </label>
            ))}
          </div>
        </fieldset>

        <div>
          <label for="topic" class={label}>What would you like support with? <span class={optional}>(optional)</span></label>
          <select id="topic" name="topic" class={field}>
            <option value="">Not sure yet</option>
            {topics.map((topic) => <option>{topic}</option>)}
          </select>
        </div>

        <div>
          <label for="message" class={label}>Your message <span class={optional}>(optional)</span></label>
          <p id="message-hint" class={hint}>A sentence or two is plenty. Please don't include detailed health information here.</p>
          <textarea id="message" name="message" rows="5" aria-describedby="message-hint" class={field}></textarea>
        </div>

        <div>
          <button type="submit" class={`${buttonPrimary} w-full cursor-pointer aria-disabled:cursor-wait aria-disabled:opacity-60 sm:w-auto`}>Send message</button>
          <p class="mt-4 max-w-[65ch] text-base leading-relaxed text-body">
            <strong class="text-ink">What happens next:</strong> you stay on this page, and a short note confirms your message was sent.
          </p>
          <div id="form-error" role="alert" hidden class="mt-4 max-w-[65ch] rounded-2xl border-2 border-ink bg-surface p-5 text-base leading-relaxed text-body">
            <strong class="text-ink">Sorry, your message did not send.</strong> Nothing you typed has been lost. Please try again, or call{" "}
            <a href={phone.href} class={textLink}>{phone.label}</a>.
          </div>
        </div>
      </form>
    </div>
  </section>

  <!-- Psychology Today -->
  <section class={`${container} py-6`} aria-labelledby="pt-heading">
    <h2 id="pt-heading" class={h2}>Curious about working together?</h2>
    <p class="mt-4 max-w-[65ch] text-lg leading-relaxed">
      Visit our Psychology Today profile to learn more about our counselling services and approach.
    </p>
    <a href={psychologyTodayUrl} target="_blank" rel="noopener noreferrer" class={`${textLink} mt-4 inline-flex min-h-11 items-center gap-2`}>
      View our Psychology Today profile (opens in a new tab)
    </a>
  </section>
</Layout>

<script>
  // Sends the form in the background so the visitor stays on the page and gets a clear confirmation.
  const form = document.querySelector<HTMLFormElement>("#contact-form");
  const done = document.querySelector<HTMLElement>("#form-done");
  const error = document.querySelector<HTMLElement>("#form-error");
  const button = form?.querySelector<HTMLButtonElement>("button[type=submit]");

  if (form && done && error && button) {
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      // aria-disabled rather than disabled, so the button keeps keyboard focus while sending.
      if (button.getAttribute("aria-disabled") === "true") return;
      button.setAttribute("aria-disabled", "true");
      button.textContent = "Sending…";
      error.hidden = true;

      try {
        const response = await fetch(form.dataset.ajax!, {
          method: "POST",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify(Object.fromEntries(new FormData(form))),
        });
        const result = await response.json();
        if (!response.ok || String(result.success) !== "true") throw new Error(result.message);
        form.hidden = true;
        done.hidden = false;
        done.focus();
      } catch {
        error.hidden = false;
        button.removeAttribute("aria-disabled");
        button.textContent = "Send message";
      }
    });
  }
</script>
