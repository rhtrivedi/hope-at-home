---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/PageHero.astro";
import { card, email, hours, phone, psychologyTodayUrl } from "../data/site";

const topics = [
  "Postpartum",
  "Anxiety & Depression",
  "ADHD",
  "Couples Counselling",
  "Child & Youth Counselling",
  "Individual Counselling",
  "Insurance & coverage",
  "Something else",
];

const contactMethods = ["Email", "Phone call", "Text message"];

const label = "block text-sm font-semibold text-zinc-900";
const field =
  "mt-2 block w-full rounded-xl border border-zinc-300 bg-zinc-50 px-4 py-3.5 text-base text-zinc-900 placeholder:text-zinc-400 transition-all duration-300 hover:border-zinc-400 focus:border-sage-500 focus:bg-white focus:outline-none focus:ring-2 focus:ring-sage-500 focus:ring-offset-2";
const tileHeading = "text-xs font-semibold uppercase tracking-[0.2em]";
---

<Layout
  title="Contact Us — Hope at Home Counselling Services"
  description="Reach out to Hope at Home Counselling Services. Call 519-701-5740, email, or send a message. Open Monday to Friday 9am–9pm and Saturday 9am–5pm."
>
  <Header />

  <main class="mx-auto max-w-7xl px-5 pb-12 sm:px-8">
    <PageHero
      eyebrow="Contact us"
      title="When you are ready, we are here."
      lead="Curious about working together? Send a message, call, or email — whichever feels easiest."
      watermark="hello"
    />

    <div class="grid gap-4 sm:gap-5 lg:grid-cols-12">
      <!-- Form -->
      <section class="reveal self-start rounded-2xl border border-zinc-200 bg-white p-8 shadow-xl sm:p-12 lg:col-span-7 lg:p-16" aria-labelledby="form-heading">
        <h2 id="form-heading" class="font-display text-3xl font-medium tracking-tight text-zinc-900 sm:text-4xl">Let's connect</h2>
        <p class="mt-3 text-sm">Fields marked <span class="font-semibold text-rose-600">*</span> are required.</p>

        <!-- TODO: point this at a form backend. Until then it opens the visitor's email app. -->
        <form action={`mailto:${email}`} method="post" enctype="text/plain" class="mt-10 grid gap-6 sm:grid-cols-2">
          <div>
            <label for="name" class={label}>Your name <span class="text-rose-600" aria-hidden="true">*</span></label>
            <input id="name" name="name" type="text" autocomplete="name" required class={field} />
          </div>

          <div>
            <label for="email" class={label}>Email <span class="text-rose-600" aria-hidden="true">*</span></label>
            <input id="email" name="email" type="email" autocomplete="email" required placeholder="you@example.com" class={field} />
          </div>

          <div>
            <label for="phone" class={label}>Phone <span class="font-normal text-zinc-500">(optional)</span></label>
            <input id="phone" name="phone" type="tel" autocomplete="tel" class={field} />
          </div>

          <div>
            <label for="topic" class={label}>What brings you here?</label>
            <select id="topic" name="topic" class={field}>
              <option value="">Choose one (optional)</option>
              {topics.map((topic) => <option>{topic}</option>)}
            </select>
          </div>

          <fieldset class="sm:col-span-2">
            <legend class={label}>How should we get back to you?</legend>
            <div class="mt-3 flex flex-wrap gap-3">
              {contactMethods.map((method, i) => (
                <label class="cursor-pointer">
                  <input type="radio" name="contact-method" value={method} checked={i === 0} class="peer sr-only" />
                  <span class="block rounded-xl border border-zinc-300 bg-zinc-50 px-5 py-3 text-sm font-medium text-zinc-700 transition-all duration-300 hover:border-zinc-400 peer-checked:border-sage-600 peer-checked:bg-sage-100 peer-checked:text-zinc-900 peer-focus-visible:ring-2 peer-focus-visible:ring-sage-500 peer-focus-visible:ring-offset-2">
                    {method}
                  </span>
                </label>
              ))}
            </div>
          </fieldset>

          <div class="sm:col-span-2">
            <label for="message" class={label}>Your message <span class="text-rose-600" aria-hidden="true">*</span></label>
            <textarea id="message" name="message" rows="6" required aria-describedby="message-hint" class={field}></textarea>
            <p id="message-hint" class="mt-2 text-sm text-zinc-500">
              A sentence or two is plenty. Please don't include detailed health information here.
            </p>
          </div>

          <div class="sm:col-span-2">
            <button type="submit" data-magnetic class="w-full rounded-xl bg-rose-600 px-7 py-4 text-base font-semibold text-white transition-all duration-300 hover:scale-[1.02] hover:bg-rose-700 hover:shadow-lg focus:outline-none focus-visible:ring-2 focus-visible:ring-sage-500 focus-visible:ring-offset-2 sm:w-auto">
              Send message
            </button>
          </div>
        </form>
      </section>

      <!-- Details -->
      <aside class="grid content-start gap-4 sm:grid-cols-2 sm:gap-5 lg:col-span-5 lg:mt-16 lg:grid-cols-1" aria-label="Contact details">
        <a href={phone.href} class={`${card} block bg-zinc-900 p-8 text-white sm:p-10`}>
          <h2 class={`${tileHeading} text-zinc-400`}>Telephone</h2>
          <p class="mt-4 font-display text-4xl font-medium">{phone.label}</p>
        </a>

        <a href={`mailto:${email}`} class={`${card} block border border-zinc-200 bg-white p-8 sm:p-10`}>
          <h2 class={`${tileHeading} text-rose-600`}>Email</h2>
          <p class="mt-4 break-all font-display text-xl font-medium text-zinc-900">{email}</p>
        </a>

        <div class="reveal rounded-2xl bg-sage-200 p-8 sm:p-10">
          <h2 class={`${tileHeading} text-sage-800`}>Schedule &amp; availability</h2>
          <dl class="mt-5 space-y-3">
            {hours.map((slot) => (
              <div class="flex flex-wrap justify-between gap-x-6 gap-y-1">
                <dt class="text-sage-900">{slot.days}</dt>
                <dd class="font-semibold text-zinc-900">{slot.time}</dd>
              </div>
            ))}
          </dl>
        </div>

        <a href={psychologyTodayUrl} target="_blank" rel="noopener noreferrer" class={`${card} group block border border-zinc-200 bg-white p-8 sm:p-10`}>
          <h2 class={`${tileHeading} text-rose-600`}>Psychology Today</h2>
          <p class="mt-4 leading-relaxed">Visit our Psychology Today profile to learn more about our counselling services and approach.</p>
          <span class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-zinc-900">
            View profile
            <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">&rarr;</span>
          </span>
        </a>

        <div class="reveal rounded-2xl border border-rose-100 bg-rose-50 p-8 sm:col-span-2 sm:p-10 lg:col-span-1">
          <h2 class={`${tileHeading} text-rose-700`}>Need help right now?</h2>
          <p class="mt-4 text-sm leading-relaxed text-zinc-700">
            This form isn't monitored for emergencies. If you're in crisis, call or text{" "}
            <a href="tel:988" class="font-semibold text-zinc-900 underline underline-offset-4">9-8-8</a>{" "}
            (Suicide Crisis Helpline, Canada) or call{" "}
            <a href="tel:911" class="whitespace-nowrap font-semibold text-zinc-900 underline underline-offset-4">9-1-1</a>.
          </p>
        </div>
      </aside>
    </div>
  </main>

  <Footer />
</Layout>
