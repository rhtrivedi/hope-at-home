---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import ContactCta from "../../components/ContactCta.astro";
import { insurers } from "../../data/insurers";
import { card, container, h2, h3, textLink } from "../../data/site";

const field =
  "mt-2 block min-h-14 w-full rounded-xl border-2 border-field bg-surface px-4 py-3 text-lg text-ink transition-colors duration-300 hover:border-ink";
---

<Layout
  title="Insurance Providers — Hope at Home Counselling Services"
  description="The insurance providers Hope at Home Counselling Services is registered with, including Canada Life, Manulife, Desjardins, GreenShield and Medavie Blue Cross."
>
  <PageHero
    eyebrow="Insurance providers"
    title="Insurers we are registered with."
    lead="The list is in A to Z order. Find yours by name, or type it in the box."
    back={{ label: "Services", href: "/services" }}
  />

  <section class={`${container} py-6 sm:py-10`} aria-labelledby="list-heading">
    <h2 id="list-heading" class="sr-only">List of insurers</h2>

    <!-- The filter is an extra: without JavaScript the whole list simply stays visible. -->
    <div class="js-only max-w-xl">
      <label for="insurer-filter" class="block text-lg font-bold text-ink">Find your insurer</label>
      <p id="insurer-filter-hint" class="mt-1 text-base text-body">Start typing a name. The list below gets shorter as you type.</p>
      <input id="insurer-filter" type="search" autocomplete="off" aria-describedby="insurer-filter-hint" class={field} />
    </div>
    <p id="insurer-count" role="status" class="mt-4 text-base font-bold text-ink">{insurers.length} insurers</p>

    <!-- Every tile has the name as text. Logos sit on a light tile in both themes, all at the same medium size. -->
    <ul id="insurer-list" class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
      {
        insurers.map((insurer) => (
          <li data-name={insurer.name.toLowerCase()} class="flex flex-col rounded-2xl border-2 border-line bg-surface p-3">
            <div class="grid h-28 place-items-center rounded-xl bg-logo-tile p-4">
              {insurer.logo ? (
                <img src={`/images/insurers/${insurer.logo}`} alt="" loading="lazy" class="max-h-16 w-auto max-w-full object-contain" />
              ) : (
                <span class="font-display text-2xl font-semibold text-on-accent" aria-hidden="true">
                  {insurer.abbr}
                </span>
              )}
            </div>
            <p class="mt-3 px-1 pb-1 text-base font-bold leading-snug text-ink">{insurer.name}</p>
          </li>
        ))
      }
    </ul>

    <p id="insurer-empty" hidden class="mt-6 max-w-[65ch] rounded-2xl border-2 border-ink bg-surface p-6 text-lg leading-relaxed text-body">
      <strong class="text-ink">No insurer matches that name.</strong> Check the spelling, or{" "}
      <a href="/contact" class={textLink}>reach out</a> and we will do our best to help.
    </p>
  </section>

  <section class={`${container} py-6 sm:py-10`} aria-label="Good to know">
    <div class="grid gap-4 md:grid-cols-2">
      <div class={card}>
        <h2 class={h3}>Provider not listed?</h2>
        <p class="mt-3 text-lg leading-relaxed text-body">
          Please reach out. We'll do our best to support you with the registration process where possible.
        </p>
        <a href="/contact" class={`${textLink} mt-4 inline-flex min-h-11 items-center gap-2`}>
          Reach out <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
      <div class="rounded-2xl bg-tint p-6 sm:p-8">
        <h2 class={h3}>Please check first</h2>
        <p class="mt-3 text-lg leading-relaxed text-body">
          Coverage varies by plan. We recommend checking with your insurance provider to confirm your individual benefits.
        </p>
        <a href="/services#programs" class={`${textLink} mt-4 inline-flex min-h-11 items-center gap-2`}>
          See funded programs (NIHB and VQRP+) <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <ContactCta />
</Layout>

<script>
  // Narrows the list as the visitor types. Nothing moves or animates: tiles that do not match are simply hidden.
  const input = document.querySelector<HTMLInputElement>("#insurer-filter");
  const items = [...document.querySelectorAll<HTMLElement>("#insurer-list > li")];
  const count = document.querySelector<HTMLElement>("#insurer-count");
  const empty = document.querySelector<HTMLElement>("#insurer-empty");

  if (input && count && empty) {
    input.addEventListener("input", () => {
      const query = input.value.trim().toLowerCase();
      let shown = 0;
      for (const item of items) {
        const match = item.dataset.name!.includes(query);
        item.hidden = !match;
        if (match) shown++;
      }
      count.textContent = query ? `${shown} of ${items.length} insurers shown` : `${items.length} insurers`;
      empty.hidden = shown > 0;
    });
  }
</script>
