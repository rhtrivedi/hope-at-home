---
import { nav } from "../data/site";

const { pathname } = Astro.url;
const isCurrent = (href: string) => (href === "/" ? pathname === "/" : pathname.startsWith(href));
---

<header class="sticky top-0 z-50 border-b border-zinc-200/70 bg-zinc-50/80 backdrop-blur-md">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-5 py-4 sm:px-8">
    <a href="/" class="flex items-center gap-3" aria-label="Hope at Home Counselling Services — home">
      <img src="/images/logo-mark-small.png" alt="" width="390" height="192" class="h-11 w-auto sm:h-12" />
      <span class="leading-none">
        <img src="/images/logo-wordmark.png" alt="" width="826" height="200" class="h-8 w-auto sm:h-9" />
        <span class="hidden text-[0.6rem] font-medium uppercase tracking-[0.25em] text-zinc-500 sm:block">Counselling Services</span>
      </span>
    </a>

    <nav class="hidden items-center gap-8 lg:flex" aria-label="Primary">
      {nav.map((item) => (
        <a
          href={item.href}
          aria-current={isCurrent(item.href) ? "page" : undefined}
          class="link-draw text-sm font-medium text-zinc-600 hover:text-zinc-900 aria-[current=page]:text-zinc-900"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <a href="/contact" data-magnetic class="hidden rounded-xl bg-rose-600 px-5 py-2.5 text-sm font-semibold text-white transition-all duration-300 hover:scale-[1.02] hover:bg-rose-700 hover:shadow-lg sm:inline-block">
        Let's Connect
      </a>
      <details class="group relative lg:hidden">
        <summary class="grid size-10 cursor-pointer list-none place-items-center rounded-xl border border-zinc-200 bg-white text-zinc-900 [&::-webkit-details-marker]:hidden">
          <span class="sr-only">Menu</span>
          <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16" />
          </svg>
        </summary>
        <nav class="absolute right-0 mt-3 w-60 rounded-2xl border border-zinc-200 bg-white p-3 shadow-xl" aria-label="Mobile">
          {nav.map((item) => (
            <a href={item.href} class="block rounded-xl px-4 py-3 text-sm font-medium text-zinc-700 transition-colors duration-300 hover:bg-sage-100 hover:text-zinc-900">
              {item.label}
            </a>
          ))}
          <a href="/contact" class="mt-2 block rounded-xl bg-rose-600 px-4 py-3 text-center text-sm font-semibold text-white sm:hidden">
            Let's Connect
          </a>
        </nav>
      </details>
    </div>
  </div>
</header>
