---
import { container, nav } from "../data/site";

const { pathname } = Astro.url;
const isCurrent = (href: string) => (href === "/" ? pathname === "/" : pathname.startsWith(href));

const link =
  "flex min-h-12 items-center rounded-xl px-4 text-base font-bold text-body transition-colors duration-300 hover:bg-tint hover:text-ink aria-[current=page]:bg-tint-strong aria-[current=page]:text-ink aria-[current=page]:underline aria-[current=page]:decoration-2 aria-[current=page]:underline-offset-8";
---

<!-- Not sticky on purpose: nothing follows the reader down the page. -->
<header class="border-b-2 border-line bg-surface">
  <div class={`${container} flex items-center justify-between gap-4 py-4`}>
    <a href="/" class="flex items-center gap-2 rounded-xl sm:gap-3" aria-label="Hope at Home Counselling Services, home page">
      <img src="/images/logo-mark-small.png" alt="" width="390" height="192" class="logo h-9 w-auto sm:h-12" />
      <img src="/images/logo-wordmark.png" alt="" width="826" height="200" class="logo h-6 w-auto sm:h-9" />
    </a>

    <nav class="hidden lg:block" aria-label="Main">
      <ul class="flex items-center gap-1">
        {nav.map((item) => (
          <li>
            <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined} class={link}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- The button says "Menu" in words, not only an icon. -->
    <details class="relative lg:hidden">
      <summary class="flex min-h-12 cursor-pointer list-none items-center gap-2 rounded-xl border-2 border-ink bg-surface px-4 text-base font-bold text-ink [&::-webkit-details-marker]:hidden">
        <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
        Menu
      </summary>
      <nav class="absolute right-0 z-40 mt-3 w-64 rounded-2xl border-2 border-ink bg-surface p-2 shadow-xl" aria-label="Main">
        <ul>
          {nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined} class={link}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </details>
  </div>
</header>
