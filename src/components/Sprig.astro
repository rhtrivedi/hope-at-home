---
// A still line-drawn sprig, after the botanical sketch in the client's deck. Decorative only.
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  viewBox="0 0 120 120"
  class:list={["shrink-0", className]}
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d="M18 112C38 88 62 58 100 10" />
  <path d="M34 93C18 92 10 82 10 70c14 2 23 10 24 23z" />
  <path d="M44 80c10-10 24-6 32 6-14 4-26 2-32-6z" />
