  <path d="M66 50c10-9 24-5 31 7-13 4-25 1-31-7z" />
  <path d="M78 34C64 32 58 22 60 11c11 3 17 11 18 23z" />
  <path d="M88 24c2-10 8-16 18-18 0 10-6 17-18 18z" />
</svg>
