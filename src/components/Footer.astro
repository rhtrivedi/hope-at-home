---
import { nav } from "../data/site";
---

<footer class="mx-auto max-w-7xl px-5 pb-12 pt-20 sm:px-8">
  <div class="flex flex-col gap-10 md:flex-row md:items-end md:justify-between">
    <a href="/" class="reveal inline-block" aria-label="Hope at Home Counselling Services — home">
      <img src="/images/logo-mark.png" alt="" width="974" height="480" loading="lazy" class="h-24 w-auto sm:h-28" />
      <img src="/images/logo-wordmark.png" alt="" width="826" height="200" loading="lazy" class="mt-2 h-10 w-auto sm:h-12" />
      <span class="mt-3 block text-[0.65rem] font-medium uppercase tracking-[0.3em] text-zinc-500">Counselling Services</span>
    </a>
    <nav class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-zinc-500" aria-label="Footer">
      {nav.map((item) => (
        <a href={item.href} class="link-draw hover:text-zinc-900">{item.label}</a>
      ))}
    </nav>
  </div>
  <p class="mt-12 border-t border-zinc-200 pt-6 text-sm text-zinc-500">&copy; {new Date().getFullYear()} Hope at Home Counselling Services</p>
</footer>
