---
import { container, email, hours, nav, phone, textLink } from "../data/site";

const heading = "font-display text-xl font-semibold text-on-deep";
const footerLink =
  "inline-flex min-h-11 items-center rounded font-semibold text-on-deep underline decoration-2 underline-offset-4 transition-colors duration-300 hover:bg-on-deep hover:text-deep";
---

<!-- The one deep-green band on the site: it marks the end of every page. -->
<footer class="mt-12 bg-deep text-on-deep sm:mt-16">
  <div class={`${container} py-12 sm:py-16`}>
    <!-- Shown on every page, so help is never more than a scroll away. -->
    <p class="max-w-[65ch] rounded-2xl bg-surface p-6 text-base leading-relaxed text-body">
      <strong class="text-ink">Need help right now?</strong> This website is not monitored for emergencies. If you are in crisis, call or
      text <a href="tel:988" class={textLink}>9-8-8</a> (Suicide Crisis Helpline, Canada) or call <a href="tel:911" class={textLink}>9-1-1</a>.
    </p>

    <div class="on-deep mt-12 grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
      <nav aria-label="Footer">
        <h2 class={heading}>Pages</h2>
        <ul class="mt-3">
          {nav.map((item) => (
            <li>
              <a href={item.href} class={footerLink}>{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <div>
        <h2 class={heading}>Contact</h2>
        <ul class="mt-3">
          <li>
            <a href={phone.href} class={footerLink}>Call {phone.label}</a>
          </li>
          <li>
            <a href={`mailto:${email}`} class={`${footerLink} [overflow-wrap:anywhere]`}>{email}</a>
          </li>
        </ul>
      </div>

      <div>
        <h2 class={heading}>Hours</h2>
        <dl class="mt-3 space-y-3 text-base">
          {hours.map((slot) => (
            <div>
              <dt class="font-bold">{slot.days}</dt>
              <dd>{slot.time}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>

    <div class="on-deep mt-12 flex flex-col gap-4 border-t-2 border-on-deep/30 pt-6 text-base sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {new Date().getFullYear()} Hope at Home Counselling Services</p>
      <a href="#main" class={footerLink}>Back to top</a>
    </div>
  </div>
</footer>
