---
import { steps } from "../data/faq";
import { container, eyebrow, h2, h3, textLink } from "../data/site";
---

<!-- Knowing what will happen, in order, takes a lot of the worry out of reaching out. -->
<section class={`${container} py-10 sm:py-14`} aria-labelledby="steps-heading">
  <p class={eyebrow}>How it works</p>
  <h2 id="steps-heading" class={`${h2} mt-2`}>Getting started, in three steps</h2>

  <ol class="mt-8 grid gap-4 md:grid-cols-3">
    {
      steps.map((step, i) => (
        <li class="rounded-2xl bg-tint p-6 sm:p-8">
          <span class="grid size-12 place-items-center rounded-full border-2 border-ink bg-accent font-display text-2xl font-semibold text-on-accent" aria-hidden="true">
            {i + 1}
          </span>
          <h3 class={`${h3} mt-5`}>
            <span class="sr-only">Step {i + 1}: </span>
            {step.title}
          </h3>
          <p class="mt-3 text-lg leading-relaxed text-body">{step.body}</p>
        </li>
      ))
    }
  </ol>

  <a href="/services#questions" class={`${textLink} mt-6 inline-flex min-h-11 items-center gap-2`}>
    See common questions <span aria-hidden="true">&rarr;</span>
  </a>
</section>
