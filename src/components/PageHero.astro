---
import Sprig from "./Sprig.astro";
import { container, eyebrow as eyebrowClass, h1, textLink } from "../data/site";

interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  /** Shown above the title as a way back up one level. */
  back?: { label: string; href: string };
}

const { eyebrow, title, lead, back } = Astro.props;
---

<!-- Every inner page opens with the same sage band, so it is always clear where a page starts. -->
<section class="mb-6 border-b-2 border-line bg-tint">
  <div class={`${container} flex items-center justify-between gap-10 py-10 sm:py-16`}>
    <div>
      {
        back && (
          <a href={back.href} class={`${textLink} inline-flex min-h-11 items-center gap-2 text-base`}>
            <span aria-hidden="true">&larr;</span> Back to {back.label}
          </a>
        )
      }
      {eyebrow && <p class={eyebrowClass}>{eyebrow}</p>}
      <h1 class={`${h1} mt-3 max-w-3xl`}>{title}</h1>
      {lead && <p class="mt-5 max-w-[65ch] text-xl leading-relaxed text-body">{lead}</p>}
    </div>
    <!-- A still drawing on wider screens: the sprig by default, or whatever a page passes as "art". -->
    <div class="hidden text-brand md:block">
      <slot name="art"><Sprig class="size-36" /></slot>
    </div>
  </div>
</section>
