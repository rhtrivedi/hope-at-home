---
// TODO: placeholder stock photo (Unsplash), not Kunjal. Before launch, replace
// public/images/portrait-placeholder.jpg with her own portrait (4:5, at least 800×1000) and fix the alt text.
interface Props {
  class?: string;
  loading?: "eager" | "lazy";
}

const { class: className, loading = "lazy" } = Astro.props;
---

<figure class:list={["w-full max-w-xs", className]}>
  <!-- Styled as a sticker: a thick light edge, a fixed slight tilt and a soft shadow. It is still: nothing here moves. -->
  <div class="-rotate-2 rounded-[2rem] border-2 border-ink bg-surface p-3 shadow-xl">
    <img
      src="/images/portrait-placeholder.jpg"
      alt="Portrait of Kunjal Bhatt (placeholder photo)"
      width="800"
      height="1000"
      loading={loading}
      class="aspect-[4/5] w-full rounded-3xl object-cover"
    />
  </div>
  <figcaption class="mt-6">
    <span class="block font-display text-xl font-semibold text-ink">Kunjal Bhatt</span>
    <span class="block text-base text-body">BSW, MSW, RSW &middot; Registered Social Worker</span>
  </figcaption>
</figure>
