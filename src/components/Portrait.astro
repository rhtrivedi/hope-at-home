---
// Kunjal's cut-out photo from the client's PowerPoint (Website.pptx, October 2026), shown as a sticker.
// The edges were cleaned up (leftover background between the legs and under the left elbow removed).
// Astro resizes the large source PNG at build time, so visitors download a small WebP.
import { Image } from "astro:assets";
import sticker from "../assets/kunjal-sticker.png";

interface Props {
  class?: string;
  loading?: "eager" | "lazy";
}

const { class: className, loading = "lazy" } = Astro.props;
---

<figure class:list={["w-full max-w-60", className]}>
  <!-- The sticker edge is a ring of still shadows in the page's surface colour, with one soft shadow under it. Nothing here moves. -->
  <Image
    src={sticker}
    alt="Kunjal Bhatt smiling, in sunglasses and a cream vest"
    widths={[240, 480, 720]}
    sizes="15rem"
    format="webp"
    loading={loading}
    class="sticker h-auto w-full"
  />
  <figcaption class="mt-6">
    <span class="block font-display text-xl font-semibold text-ink">Kunjal Bhatt</span>
    <span class="block text-base text-body">BSW, MSW, RSW &middot; Registered Social Worker</span>
  </figcaption>
</figure>
