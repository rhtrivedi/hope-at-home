---
// One still line drawing per area of care, in the style of the logo: a single dark line with a pink heart.
// Purely decorative — the area's name always sits next to it as text.
interface Props {
  slug: string;
  class?: string;
}

const { slug, class: className } = Astro.props;
const heart = "fill-accent-strong stroke-none";
---

<svg
  viewBox="0 0 64 64"
  class:list={["shrink-0", className]}
  fill="none"
  stroke="currentColor"
  stroke-width="2.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {/* Postpartum: a small heart held inside a larger one. */}
  {
    slug === "postpartum" && (
      <>
        <path d="M32 55C14 43 8 33 8 23a12 12 0 0 1 24-4 12 12 0 0 1 24 4c0 10-6 20-24 32z" />
        <path class={heart} d="M32 42c-6-4-8-7-8-10a4 4 0 0 1 8-1.5 4 4 0 0 1 8 1.5c0 3-2 6-8 10z" />
      </>
    )
  }
  {/* Anxiety & Depression: the sun coming up — "brighter days". */}
  {
    slug === "anxiety-depression" && (
      <>
        <path d="M6 46h52M16 46a16 16 0 0 1 32 0M32 22v-8M15 29l-5.5-5.5M49 29l5.5-5.5M18 55h28" />
        <path class={heart} d="M32 43c-4.5-3-6-5.2-6-7.5a3 3 0 0 1 6-1.1 3 3 0 0 1 6 1.1c0 2.300-1.500 4.500-6 7.500z" />
      </>
    )
  }
  {/* ADHD: a tangle that settles into steps — "manageable steps". */}
  {
    slug === "adhd" && (
      <>
        <path d="M5 34c6-14 16-12 12-2-4 10-14 4-6-4 6-6 14 2 8 10-3 4 2 8 6 6h8v-8h8v-8h8v-8h8" />
        <path class={heart} d="M52 13c-4.500-3-6-5.200-6-7.500a3 3 0 0 1 6-1.100 3 3 0 0 1 6 1.100c0 2.300-1.500 4.500-6 7.500z" />
      </>
    )
  }
  {/* Couples: two hearts, overlapping. */}
  {
    slug === "couples-counselling" && (
      <>
        <path class="fill-accent" d="M40 50C28 42 24 35 24 29a8 8 0 0 1 16-3 8 8 0 0 1 16 3c0 6-4 13-16 21z" />
        <path d="M24 50C12 42 8 35 8 29a8 8 0 0 1 16-3 8 8 0 0 1 16 3c0 6-4 13-16 21z" />
      </>
    )
  }
  {/* Parent Coaching: a home with a heart inside, like the logo. */}
  {
    slug === "parent-coaching" && (
      <>
        <path d="M8 31L32 10l24 21M15 26v28h34V26" />
        <path class={heart} d="M32 47c-4.5-3-6-5.2-6-7.5a3 3 0 0 1 6-1.1 3 3 0 0 1 6 1.1c0 2.3-1.5 4.5-6 7.5z" />
      </>
    )
  }
  {/* Emotional Regulation: big waves that settle into a calm line. */}
  {
    slug === "emotional-regulation" && (
      <>
        <path d="M4 38c4-18 8-18 12 0s8 14 12 0 6-8 9 0 5 4 8 0h15" />
        <path class={heart} d="M51 28c-4.5-3-6-5.2-6-7.5a3 3 0 0 1 6-1.1 3 3 0 0 1 6 1.1c0 2.3-1.5 4.5-6 7.5z" />
      </>
    )
  }
  {/* Work-Related Stress: a set of scales, level — "a more balanced life". */}
  {
    slug === "work-related-stress" && (
      <>
        <path d="M32 20v34M22 54h20M12 24h40M12 24L6 38a6 5 0 0 0 12 0zM52 24l-6 14a6 5 0 0 0 12 0z" />
        <path class={heart} d="M32 17c-4.5-3-6-5.2-6-7.5a3 3 0 0 1 6-1.1 3 3 0 0 1 6 1.1c0 2.3-1.5 4.5-6 7.5z" />
      </>
    )
  }
  {/* Trauma Healing: a new shoot growing from the ground. */}
  {
    slug === "trauma-healing" && (
      <>
        <path d="M12 55h40M32 55V30M32 43c-8 0-14-6-14-12 8 0 14 4 14 12zM32 36c8 0 14-6 14-12-8 0-14 4-14 12z" />
        <path class={heart} d="M32 22c-4.5-3-6-5.2-6-7.5a3 3 0 0 1 6-1.1 3 3 0 0 1 6 1.1c0 2.3-1.5 4.5-6 7.5z" />
      </>
    )
  }
</svg>
