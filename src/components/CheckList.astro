---
interface Props {
  items: string[];
}

const { items } = Astro.props;
---

<ul class="max-w-[65ch] space-y-4 text-lg leading-relaxed text-body">
  {
    items.map((item) => (
      <li class="flex gap-4">
        <svg viewBox="0 0 24 24" class="mt-1 size-6 shrink-0 text-brand" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12.5l4.5 4.5L19 7.5" />
        </svg>
        <span>{item}</span>
      </li>
    ))
  }
</ul>
