---
import { buttonPrimary, buttonSecondary, container, h2, phone } from "../data/site";
---

<section class={`${container} py-10 sm:py-14`} aria-labelledby="contact-heading">
  <div class="rounded-2xl border-2 border-line bg-tint-strong p-6 sm:p-12">
    <h2 id="contact-heading" class={h2}>When you are ready, we are here.</h2>
    <p class="mt-4 max-w-[65ch] text-lg leading-relaxed text-body">Send a message, call, or email. Choose whichever feels easiest.</p>
    <div class="mt-8 flex flex-col gap-4 sm:flex-row">
      <a href="/contact" class={buttonPrimary}>Let's Connect</a>
      <a href={phone.href} class={buttonSecondary}>Call {phone.label}</a>
    </div>
  </div>
</section>
