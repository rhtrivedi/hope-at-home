---
// Fonts are served from this site (no third-party font requests): better for privacy and speed.
import "@fontsource-variable/atkinson-hyperlegible-next";
import "@fontsource-variable/fraunces/soft.css";
// Italic headings on the About page only.
import "@fontsource-variable/fraunces/soft-italic.css";
import "../styles/global.css";
import ReadingSettings from "../components/ReadingSettings.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Applies saved reading settings before the first paint, so the page never flashes or jumps after loading.
         Colours follow the device's light/dark setting unless the visitor has chosen one. -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.classList.add("js");
        const saved = (pref) => {
          try {
            return localStorage.getItem("hah-" + pref);
          } catch {
            return null;
          }
        };
        for (const pref of ["text", "spacing"]) {
          const value = saved(pref);
          if (value && value !== "standard") root.dataset[pref] = value;
        }
        const theme = saved("theme");
        if (theme === "dark" || (theme !== "light" && matchMedia("(prefers-color-scheme: dark)").matches)) root.dataset.theme = "dark";
      })();
    </script>
  </head>
  <body class="flex min-h-screen flex-col bg-page font-sans text-lg text-body antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-xl focus:border-2 focus:border-ink focus:bg-surface focus:px-5 focus:py-3 focus:font-bold focus:text-ink"
    >
      Skip to main content
    </a>
    <ReadingSettings />
    <Header />
    <main id="main" tabindex="-1" class="flex-1 focus:outline-none">
      <slot />
    </main>
    <Footer />
  </body>
</html>
